      "outputs": [],
      "source": [
        "def ask_research_paper(question):\n",
        "\n",
        "    docs = retriever.invoke(question)\n",
        "\n",
        "    context = \"\\n\\n\".join(\n",
        "        doc.page_content\n",
        "        for doc in docs\n",
        "    )\n",
        "\n",
        "    answer = generate_answer(\n",
        "        question,\n",
        "        context\n",
        "    )\n",
        "\n",
        "    pages = sorted(\n",
        "        set(\n",
        "            doc.metadata.get(\"page\", 0) + 1\n",
        "            for doc in docs\n",
        "        )\n",
        "    )\n",
        "\n",
        "    return answer, pages"
      ]
    },
