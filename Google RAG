        "from langchain_community.embeddings import HuggingFaceEmbeddings\n",
        "from langchain_community.vectorstores import FAISS\n",
        "import gradio as gr\n",
        "\n",
        "print(\"Building Google-like RAG...\")\n",
        "embeddings = HuggingFaceEmbeddings(model_name=\"all-MiniLM-L6-v2\")\n",
        "splitter = RecursiveCharacterTextSplitter(chunk_size=1000, chunk_overlap=150)\n",
        "\n",
        "def google_rag(question):\n",
        "    try:\n",
        "        # STEP 1: Search like Google (Live)\n",
        "        print(f\"Searching internet for: {question}\")\n",
        "        search = DuckDuckGoSearchResults(output_format=\"list\")\n",
        "        search_results = search.invoke(question)\n",
        "\n",
        "        urls = []\n",
        "        for r in search_results[:5]: # Top 5 results like Google\n",
        "            if 'link' in r and r['link'].startswith('http'):\n",
        "                urls.append(r['link'])\n",
        "\n",
        "        if not urls:\n",
        "            return \"Google search blocked, trying backup... Please ask again in 10 seconds.\"\n",
        "\n",
        "        print(f\"Found URLs: {urls}\")\n",
        "\n",
        "        # STEP 2: Scrape those pages live (like Google crawler)\n",
        "        loader = WebBaseLoader(urls)\n",
        "        docs = loader.load()\n",
        "\n",
        "        # STEP 3: Make temporary Vector DB (like Google Index) - On the fly\n",
        "        split_docs = splitter.split_documents(docs)\n",
        "        if not split_docs:\n",
        "            return \"Could not read pages, try again.\"\n",
        "\n",
        "        db = FAISS.from_documents(split_docs, embeddings)\n",
        "\n",
        "        # STEP 4: Retrieve answer (like Google ranking)\n",
        "        results = db.similarity_search(question, k=3)\n",
        "        context = \"\"\n",
        "        for i, r in enumerate(results):\n",
        "            context += f\"\\n[SOURCE {i+1}: {r.metadata.get('source','')}]\\n{r.page_content[:800]}\\n---\\n\"\n",
        "\n",
        "        final_answer = f\"\"\"🌍 GOOGLE-LIKE RAG ANSWER\n",
        "Question: {question}\n",
        "\n",
        "Live Searched {len(urls)} websites from internet:\n",
        "{urls}\n",
        "\n",
        "--- WORLD INFORMATION RETRIEVED ---\n",
        "{context}\n",
        "\n",
        "This is NOT from any local file. This is live from the internet for your question.\n",
        "\"\"\"\n",
        "        return final_answer\n",
        "\n",
        "    except Exception as e:\n",
        "        return f\"Error (Google search limit). Wait 1 minute and try again. Details: {str(e)[:200]}\"\n",
        "\n",
        "demo = gr.Interface(\n",
        "    fn=google_rag,\n",
        "    inputs=gr.Textbox(label=\"Ask ANYTHING - Like Google - World Knowledge\", placeholder=\"Ex: gold rate in india / Who is Elon Musk / What is happening in Israel today\"),\n",
        "    outputs=gr.Textbox(label=\"Google-like World Answer - Live from Internet\", lines=25),\n",
        "    title=\"🌍 WorldRAG - Google Clone - Knows All World Information\",\n",
        "    description=\"This is NOT a fixed PDF RAG. For every question, it searches DuckDuckGo LIVE, scrapes 5 websites, builds a temporary FAISS Vector DB, and retrieves answer. Like Google.\"\n",
        ")\n",
