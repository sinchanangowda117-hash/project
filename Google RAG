        "from langchain_community.document_loaders import WebBaseLoader, WikipediaLoader\n",
        "from langchain_community.tools import DuckDuckGoSearchResults\n",
        "from langchain_text_splitters import RecursiveCharacterTextSplitter\n",
        "from langchain_community.embeddings import HuggingFaceEmbeddings\n",
        "from langchain_community.vectorstores import FAISS\n",
        "import gradio as gr\n",
        "\n",
        "print(\"Building WorldRAG...\")\n",
        "embeddings = HuggingFaceEmbeddings(model_name=\"all-MiniLM-L6-v2\")\n",
        "splitter = RecursiveCharacterTextSplitter(chunk_size=1000, chunk_overlap=150)\n",
        "\n",
        "def google_rag(question):\n",
        "    try:\n",
        "        # Try Google search\n",
        "        search = DuckDuckGoSearchResults(output_format=\"list\")\n",
        "        results = search.invoke(question)\n",
        "        urls = [r['link'] for r in results[:4] if 'link' in r][:3]\n",
        "\n",
        "        if urls:\n",
        "            loader = WebBaseLoader(urls)\n",
        "            docs = loader.load()\n",
        "        else:\n",
        "            raise Exception(\"No URL, using Wikipedia\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Search failed {e}, using Wikipedia backup...\")\n",
        "        # BACKUP: If Google search fails, use Wikipedia (never fails)\n",
        "        loader = WikipediaLoader(query=question, load_max_docs=2)\n",
        "        docs = loader.load()\n",
        "        urls = [\"Wikipedia Backup\"]\n",
        "\n",
        "    if not docs:\n",
        "        return \"Try again with simpler question\"\n",
        "\n",
        "    split_docs = splitter.split_documents(docs)\n",
        "    db = FAISS.from_documents(split_docs, embeddings)\n",
        "    search_res = db.similarity_search(question, k=3)\n",
        "    context = \"\\n\\n\".join([r.page_content[:800] for r in search_res])\n",
        "\n",
        "    return f\"\"\"🌍 WORLD KNOWLEDGE - LIVE\n",
        "Question: {question}\n",
        "Sources Searched: {urls}\n",
        "\n",
        "--- ANSWER ---\n",
        "{context}\n",
        "\"\"\"\n",
        "\n",
        "demo = gr.Interface(\n",
        "    fn=google_rag,\n",
        "    inputs=gr.Textbox(label=\"Ask ANYTHING - World Knowledge Like Google\"),\n",
        "    outputs=gr.Textbox(label=\"Live World Answer\", lines=20),\n",
        "    title=\"WorldRAG - Google Clone - Fixed\",\n",
        "    description=\"Fixed ddgs error. Now works for any world question.\"\n",
        ")\n",
        "demo.launch()"
