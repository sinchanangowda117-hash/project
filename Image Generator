        "from diffusers import StableDiffusionPipeline\n",
        "import torch, gradio as gr\n",
        "\n",
        "pipe = StableDiffusionPipeline.from_pretrained(\"runwayml/stable-diffusion-v1-5\", dtype=torch.float16)\n",
        "pipe = pipe.to(\"cuda\")\n",
        "\n",
        "def world_gan(prompt):\n",
        "    image = pipe(prompt, num_inference_steps=25).images[0]\n",
        "    return image\n",
        "\n",
        "demo = gr.Interface(\n",
        "    fn=world_gan,\n",
        "    inputs=gr.Textbox(label=\"Type anything like Google - e.g. gold rate shop in India, futuristic AI city\"),\n",
        "    outputs=gr.Image(label=\"GAN Generated New World Image - Never existed before\"),\n",
        "    title=\"WorldGAN - Google Images but GENERATES New Images\",\n",
        "    description=\"This GAN knows all world information and creates new images\"\n",
        ")\n",
        "demo.launch()"
      ],
