      "source": [
        "from diffusers import DiffusionPipeline\n",
        "import torch, gradio as gr\n",
        "\n",
        "print(\"Loading Tiny GAN - 10x smaller, will not disconnect...\")\n",
        "# Tiny SD is only 400MB, not 4GB - made for Colab\n",
        "pipe = DiffusionPipeline.from_pretrained(\"segmind/tiny-sd\", torch_dtype=torch.float16)\n",
        "pipe = pipe.to(\"cuda\")\n",
        "pipe.enable_attention_slicing() # Saves RAM\n",
        "\n",
        "print(\"Ready!\")\n",
        "\n",
        "def generate_image(prompt):\n",
        "    if not prompt.strip():\n",
        "        prompt = \"smiling emoji\"\n",
        "    image = pipe(prompt, num_inference_steps=20, guidance_scale=7).images[0]\n",
        "    return image\n",
        "\n",
        "demo = gr.Interface(\n",
        "    fn=generate_image,\n",
        "    inputs=gr.Textbox(label=\"Type - e.g. smiling emoji, gold shop, AI robot\"),\n",
        "    outputs=gr.Image(label=\"GAN Generated Image - New\", type=\"pil\"),\n",
        "    title=\"WorldGAN - Image Generator - Fixed for T4\",\n",
        "    description=\"Tiny GAN - Will not disconnect\"\n",
        ")\n",
        "\n",
        "demo.launch(share=True, debug=False)"
      ],
