      "source": [
        "from diffusers import StableDiffusionPipeline\n",
        "import torch, gradio as gr\n",
        "\n",
        "# Auto-detect GPU or CPU - No more CUDA error\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "print(f\"Using device: {device}\")\n",
        "\n",
        "pipe = StableDiffusionPipeline.from_pretrained(\"runwayml/stable-diffusion-v1-5\", torch_dtype=torch.float32 if device==\"cpu\" else torch.float16)\n",
        "\n",
        "if device == \"cuda\":\n",
        "    pipe = pipe.to(\"cuda\")\n",
        "# If CPU, don't move to cuda - this fixes your error\n",
        "\n",
        "def world_gan(prompt):\n",
        "    # Smaller steps for CPU to be faster\n",
        "    steps = 25 if device==\"cuda\" else 15\n",
        "    image = pipe(prompt, num_inference_steps=steps).images[0]\n",
        "    return image\n",
        "\n",
        "demo = gr.Interface(\n",
        "    fn=world_gan,\n",
        "    inputs=gr.Textbox(label=\"Type anything - e.g. gold shop in India\"),\n",
        "    outputs=gr.Image(label=\"GAN Generated Image\"),\n",
        "    title=\"WorldGAN - IMAGE GENERATOR - FIXED No CUDA Error\",\n",
        "    description=f\"Running on {device} - Now working!\"\n",
        ")\n",
        "demo.launch()"
      ],
